  <node componentName="tJavaFlex" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="480" posY="80">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_1" show="false"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tJavaFlex" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.101 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Custom_Code" show="false"/>
    <elementParameter field="CHECK" name="START" value="false" show="false"/>
    <elementParameter field="CHECK" name="STARTABLE" value="true" show="false"/>
    <elementParameter field="CHECK" name="SUBTREE_START" value="false" show="false"/>
    <elementParameter field="CHECK" name="END_OF_FLOW" value="true" show="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tJavaFlex" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Talend\8.0.1\studio\configuration\lib\java" show="false"/>
    <elementParameter field="CHECK" name="DATA_AUTO_PROPAGATE" value="true"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_START" value="// ============================================================&#xA;// INICIO: Inicializar estructuras de perfilado en globalMap&#xA;// ============================================================&#xA;String[] cols_tJavaFlex_1 = new String[]{&quot;CEDULA&quot;,&quot;NOMBRES&quot;,&quot;APELLIDOS&quot;,&quot;DIRECCION_CASA&quot;,&quot;DIRECCION_OFICINA&quot;,&quot;TELEFONO_CASA&quot;,&quot;TELEFONO_OFICINA&quot;};&#xA;globalMap.put(&quot;prof_cols&quot;, cols_tJavaFlex_1);&#xA;&#xA;// Contador total de filas&#xA;globalMap.put(&quot;prof_totalCount&quot;, new int[]{0});&#xA;&#xA;// Contadores de nulos/vacíos por columna&#xA;for (String col : cols_tJavaFlex_1) {&#xA;    globalMap.put(&quot;prof_null_&quot; + col, new int[]{0});&#xA;    globalMap.put(&quot;prof_empty_&quot; + col, new int[]{0});&#xA;    globalMap.put(&quot;prof_minLen_&quot; + col, new int[]{Integer.MAX_VALUE});&#xA;    globalMap.put(&quot;prof_maxLen_&quot; + col, new int[]{0});&#xA;    globalMap.put(&quot;prof_distinct_&quot; + col, new HashSet&lt;String>());&#xA;}&#xA;&#xA;// Mapa de filas para detección de duplicados (clave = fila completa concatenada)&#xA;globalMap.put(&quot;prof_rowSet&quot;, new HashSet&lt;String>());&#xA;globalMap.put(&quot;prof_dupCount&quot;, new int[]{0});"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_MAIN" value="// ============================================================&#xA;// MAIN: Acumular métricas por cada fila&#xA;// ============================================================&#xA;// Incrementar contador total&#xA;((int[]) globalMap.get(&quot;prof_totalCount&quot;))[0]++;&#xA;&#xA;// Valores de la fila actual&#xA;String[] vals_tJavaFlex_1 = new String[]{&#xA;    input_row.CEDULA,&#xA;    input_row.NOMBRES,&#xA;    input_row.APELLIDOS,&#xA;    input_row.DIRECCION_CASA,&#xA;    input_row.DIRECCION_OFICINA,&#xA;    input_row.TELEFONO_CASA,&#xA;    input_row.TELEFONO_OFICINA&#xA;};&#xA;String[] colNames_tJavaFlex_1 = (String[]) globalMap.get(&quot;prof_cols&quot;);&#xA;&#xA;for (int i = 0; i &lt; colNames_tJavaFlex_1.length; i++) {&#xA;    String col = colNames_tJavaFlex_1[i];&#xA;    String val = vals_tJavaFlex_1[i];&#xA;    if (val == null) {&#xA;        ((int[]) globalMap.get(&quot;prof_null_&quot; + col))[0]++;&#xA;    } else {&#xA;        if (val.trim().isEmpty()) {&#xA;            ((int[]) globalMap.get(&quot;prof_empty_&quot; + col))[0]++;&#xA;        }&#xA;        int len = val.length();&#xA;        int[] minArr = (int[]) globalMap.get(&quot;prof_minLen_&quot; + col);&#xA;        int[] maxArr = (int[]) globalMap.get(&quot;prof_maxLen_&quot; + col);&#xA;        if (len &lt; minArr[0]) minArr[0] = len;&#xA;        if (len > maxArr[0]) maxArr[0] = len;&#xA;        @SuppressWarnings(&quot;unchecked&quot;)&#xA;        Set&lt;String> distSet = (Set&lt;String>) globalMap.get(&quot;prof_distinct_&quot; + col);&#xA;        distSet.add(val);&#xA;    }&#xA;}&#xA;&#xA;// Detección de filas duplicadas&#xA;String rowKey_tJavaFlex_1 = &quot;&quot;;&#xA;for (String v : vals_tJavaFlex_1) rowKey_tJavaFlex_1 += (v == null ? &quot;__NULL__&quot; : v) + &quot;||&quot;;&#xA;@SuppressWarnings(&quot;unchecked&quot;)&#xA;Set&lt;String> rowSet_tJavaFlex_1 = (Set&lt;String>) globalMap.get(&quot;prof_rowSet&quot;);&#xA;if (!rowSet_tJavaFlex_1.add(rowKey_tJavaFlex_1)) {&#xA;    ((int[]) globalMap.get(&quot;prof_dupCount&quot;))[0]++;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_END" value="// ============================================================&#xA;// FIN: No se requiere limpieza adicional&#xA;// ============================================================"/>
    <elementParameter field="CHECK" name="Version_V2_0" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V3_2" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V4.0" value="true" show="false"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.util.HashMap;&#xA;import java.util.HashSet;&#xA;import java.util.Map;&#xA;import java.util.Set;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaFlex_1">
      <column comment="" key="false" length="-1" name="CEDULA" nullable="true" pattern="" precision="-1" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="NOMBRES" nullable="true" pattern="" precision="-1" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="APELLIDOS" nullable="true" pattern="" precision="-1" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="DIRECCION_CASA" nullable="true" pattern="" precision="-1" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="DIRECCION_OFICINA" nullable="true" pattern="" precision="-1" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="TELEFONO_CASA" nullable="true" pattern="" precision="-1" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="TELEFONO_OFICINA" nullable="true" pattern="" precision="-1" type="id_String" usefulColumn="true"/>
