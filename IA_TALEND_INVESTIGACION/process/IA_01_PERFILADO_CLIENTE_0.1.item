    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="// ============================================================&#xA;// REPORTE DE PERFILADO DE DATOS - CLIENTE.csv&#xA;// ============================================================&#xA;String[] reportCols = (String[]) globalMap.get(&quot;prof_cols&quot;);&#xA;int totalRows = ((int[]) globalMap.get(&quot;prof_totalCount&quot;))[0];&#xA;int dupRows   = ((int[]) globalMap.get(&quot;prof_dupCount&quot;))[0];&#xA;&#xA;System.out.println(&quot;\n================================================================&quot;);&#xA;System.out.println(&quot;   REPORTE DE PERFILADO DE DATOS - CLIENTE.csv&quot;);&#xA;System.out.println(&quot;================================================================&quot;);&#xA;System.out.println(&quot;Total de filas procesadas : &quot; + totalRows);&#xA;System.out.println(&quot;Filas duplicadas          : &quot; + dupRows + (dupRows > 0 ? &quot;  [*** DUPLICADOS DETECTADOS ***]&quot; : &quot;&quot;));&#xA;System.out.println(&quot;----------------------------------------------------------------&quot;);&#xA;&#xA;for (String col : reportCols) {&#xA;    int nullCount  = ((int[]) globalMap.get(&quot;prof_null_&quot;  + col))[0];&#xA;    int emptyCount = ((int[]) globalMap.get(&quot;prof_empty_&quot; + col))[0];&#xA;    int minLen     = ((int[]) globalMap.get(&quot;prof_minLen_&quot; + col))[0];&#xA;    int maxLen     = ((int[]) globalMap.get(&quot;prof_maxLen_&quot; + col))[0];&#xA;    @SuppressWarnings(&quot;unchecked&quot;)&#xA;    Set&lt;String> distSet = (Set&lt;String>) globalMap.get(&quot;prof_distinct_&quot; + col);&#xA;    int distinctCount = (distSet != null) ? distSet.size() : 0;&#xA;    int nonNullRows   = totalRows - nullCount;&#xA;&#xA;    double nullRate  = (totalRows > 0) ? (nullCount  * 100.0 / totalRows) : 0.0;&#xA;    double emptyRate = (nonNullRows > 0) ? (emptyCount * 100.0 / nonNullRows) : 0.0;&#xA;&#xA;    // Ajustar minLen si no hubo valores&#xA;    if (minLen == Integer.MAX_VALUE) minLen = 0;&#xA;&#xA;    System.out.println(&quot;\nColumna: &quot; + col);&#xA;    System.out.println(&quot;  Nulos           : &quot; + nullCount  + &quot; (&quot; + String.format(&quot;%.1f&quot;, nullRate)  + &quot;%)&quot;);&#xA;    System.out.println(&quot;  Vacíos          : &quot; + emptyCount + &quot; (&quot; + String.format(&quot;%.1f&quot;, emptyRate) + &quot;% de no-nulos)&quot;);&#xA;    System.out.println(&quot;  Valores distintos: &quot; + distinctCount);&#xA;    System.out.println(&quot;  Long. mín/máx   : &quot; + minLen + &quot; / &quot; + maxLen);&#xA;&#xA;    // --- Detección de anomalías ---&#xA;    boolean anomaly = false;&#xA;    if (nullRate > 30.0) {&#xA;        System.out.println(&quot;  [!] HIGH NULL RATE: &quot; + String.format(&quot;%.1f&quot;, nullRate) + &quot;% de nulos&quot;);&#xA;        anomaly = true;&#xA;    }&#xA;    if (nonNullRows > 0 &amp;&amp; distinctCount == nonNullRows &amp;&amp; nonNullRows > 1) {&#xA;        System.out.println(&quot;  [!] POSSIBLE UNIQUE KEY: todos los valores no-nulos son distintos&quot;);&#xA;        anomaly = true;&#xA;    }&#xA;    if (nonNullRows > 0 &amp;&amp; distinctCount == 1) {&#xA;        System.out.println(&quot;  [!] CONSTANT COLUMN: todos los valores no-nulos son iguales&quot;);&#xA;        anomaly = true;&#xA;    }&#xA;    if (emptyCount > 0) {&#xA;        System.out.println(&quot;  [!] CONTAINS EMPTY STRINGS: &quot; + emptyCount + &quot; valor(es) vacío(s)&quot;);&#xA;        anomaly = true;&#xA;    }&#xA;    if (maxLen > 200) {&#xA;        System.out.println(&quot;  [!] VERY LONG VALUES: longitud máxima = &quot; + maxLen);&#xA;        anomaly = true;&#xA;    }&#xA;    if (!anomaly) {&#xA;        System.out.println(&quot;  [OK] Sin anomalías detectadas&quot;);&#xA;    }&#xA;}&#xA;&#xA;System.out.println(&quot;\n================================================================&quot;);&#xA;System.out.println(&quot;   FIN DEL REPORTE&quot;);&#xA;System.out.println(&quot;================================================================\n&quot;);"/>
